# Copy to backend/.env and adjust. Never commit the real .env file.

# --- LLM -------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current stable Flash model; see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.1
# Leaves room for Gemini 3 thinking tokens as well as the answer.
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=60
# Earlier chat messages used to understand follow-up questions.
LLM_HISTORY_MESSAGES=6

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Storage ---------------------------------------------------------------
# Relative paths resolve against the backend/ directory.
DATA_DIR=data
# Leave unset to use SQLite at DATA_DIR/researchmate.db.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/researchmate

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10
MAX_PAGES_PER_DOCUMENT=500

# --- Chunking --------------------------------------------------------------
# Tokens of the embedding model. all-MiniLM-L6-v2 reads at most 256 per chunk.
CHUNK_SIZE_TOKENS=250
CHUNK_OVERLAP_TOKENS=50

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
# cpu, mps (Apple Silicon GPU) or cuda
EMBEDDING_DEVICE=cpu
# Instruction prepended to search queries; needed by BGE/E5 models, not MiniLM.
EMBEDDING_QUERY_PREFIX=

# --- Retrieval -------------------------------------------------------------
DENSE_TOP_K=30
BM25_TOP_K=30
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
# Optional: cross-encoder logit below which a passage is not used as evidence.
# Off by default because the MS MARCO reranker's scores do not separate
# answerable from unanswerable research questions (see app/config.py).
# MIN_RERANK_SCORE=-10.0
FINAL_CONTEXT_CHUNKS=8
MAX_CONTEXT_TOKENS=6000
# Guaranteed context slots per paper when a question is limited to a few
# selected papers (e.g. comparison follow-ups); 0 turns this off.
MIN_PASSAGES_PER_PAPER=2

# --- Summaries and comparisons ---------------------------------------------
# Each paper's profile (its summary and comparison cells) retrieves this many
# passages per aspect, within a token budget, and is cached until re-indexing.
PROFILE_PASSAGES_PER_ASPECT=3
PROFILE_MAX_CONTEXT_TOKENS=8000
MAX_COMPARE_PAPERS=5
